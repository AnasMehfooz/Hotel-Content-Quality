# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# Master catalog: "synthetic" works offline; "osm" fetches real Köln/Düsseldorf hotels.
HCQ_REFERENCE=synthetic

# Feed simulation window. Leave HCQ_END_DATE unset to end today.
HCQ_DAYS=14
HCQ_SEED=42
# HCQ_END_DATE=2026-10-15

# Local LLM via Ollama (Milestone 6). A 14B model at Q4 fits a 16 GB GPU with room for context.
HCQ_OLLAMA_URL=http://localhost:11434
HCQ_LLM_MODEL=qwen3:14b
# Set to false to skip qwen3's thinking phase (faster structured output).
# HCQ_LLM_THINK=false

# Embeddings for duplicate detection (Milestone 5, optional): off | ollama
HCQ_EMBEDDINGS=off
HCQ_EMBED_MODEL=bge-m3
